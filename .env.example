# Copy to .env and edit.

# LAN IP of the machine running Docker — clients (PS2 / PCSX2) use this as DNS target
# and it must match where DNAS + game ports are reachable.
EXTERNAL_IP=192.168.1.100

# Database password for bioserver user (all-in-one and split).
# Default matches stock corbin-ch/bioserver SQL placeholders.
MYSQL_PASSWORD=xxxxxxxxxxxxxxxx

# Split compose only (docker-compose.split.yml)
MYSQL_ROOT_PASSWORD=change-me-root
